@model CarInsurance.Models.Insuree

@{
    ViewData["Title"] = "Create Insuree";
}

<h1>Create Insuree</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="EmailAddress"></label>
        <input asp-for="EmailAddress" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CarYear"></label>
        <input asp-for="CarYear" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CarMake"></label>
        <input asp-for="CarMake" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CarModel"></label>
        <input asp-for="CarModel" class="form-control" />
    </div>

    <div class="form-group form-check">
        <input asp-for="DUI" class="form-check-input" />
        <label asp-for="DUI" class="form-check-label"></label>
    </div>

    <div class="form-group">
        <label asp-for="SpeedingTickets"></label>
        <input asp-for="SpeedingTickets" class="form-control" />
    </div>

    <div class="form-group form-check">
        <input asp-for="FullCoverage" class="form-check-input" />
        <label asp-for="FullCoverage" class="form-check-label"></label>
    </div>

    <!-- Quote is intentionally not shown because the controller calculates it automatically -->

    <br />

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index">Back to List</a>
</form>